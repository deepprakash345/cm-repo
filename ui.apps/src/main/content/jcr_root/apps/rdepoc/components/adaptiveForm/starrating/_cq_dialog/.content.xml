<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Star Rating"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[rdepoc.forms.starrating.v1.editor]"
    trackingFeature="rdepoc:adaptiveform-starrating:v1">
    <content jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured">
                <items jcr:primaryType="nt:unstructured">
                    <basic jcr:primaryType="nt:unstructured">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured">
                                        <items jcr:primaryType="nt:unstructured">
                                            <placeholder jcr:primaryType="nt:unstructured" sling:hideResource="{Boolean}true"/>
                                            <maximum jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                fieldLabel="Number of stars" name="./maximum"
                                                fieldDescription="Positive whole number. Ratings run from 1 to this value."
                                                min="{Long}1" step="{Long}1" value="{Long}5" required="{Boolean}true"/>
                                            <default jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                fieldLabel="Default rating" name="./default"
                                                fieldDescription="Leave empty for no rating; otherwise use a whole number from 1 to the number of stars."
                                                min="{Long}1" step="{Long}1"/>
                                            <fieldType jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                                name="./fieldType" value="number-input"/>
                                            <type jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                                name="./type" value="integer"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </basic>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
